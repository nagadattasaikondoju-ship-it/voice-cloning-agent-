DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone
REDIS_URL=redis://localhost:6379/0

# REQUIRED: at least 32 random characters (openssl rand -hex 32). The API refuses to start without it.
JWT_SECRET=

# Private storage shared with worker-python
STORAGE_DIR=./private_storage

# Dashboard origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Whisper speech pipeline used to verify spoken consent
SPEECH_PIPELINE_URL=http://localhost:8000
CONSENT_MATCH_THRESHOLD=0.75
CONSENT_MAX_ATTEMPTS=5

# Engine availability (keys are only checked for presence here; the worker uses them)
F5_TTS_ENABLED=true
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=

PORT=8080
