# Database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone

# Redis job queue connection string
REDIS_URL=redis://localhost:6379/0

# JWT secret key for session signing
JWT_SECRET=super_secret_jwt_key_intelligence_evolve_2026

# MiniMax Voice API Credentials (provided securely by Antigravity)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Private Object / File Storage Configuration
STORAGE_TYPE=local
STORAGE_DIR=./private_storage
S3_ENDPOINT=
S3_BUCKET=voiceclone-private
S3_ACCESS_KEY=
S3_SECRET_KEY=

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:8080

# Server Port
PORT=8080
