DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone
REDIS_URL=redis://localhost:6379/0

# REQUIRED: at least 32 random characters (openssl rand -hex 32). The API refuses to start without it.
JWT_SECRET=

# Dashboard origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Sarvam AI speech-to-text (consent checks, audio -> script). Key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
CONSENT_MATCH_THRESHOLD=0.75
CONSENT_MAX_ATTEMPTS=5

# Per-user limits (0 = unlimited). Every voice, clip and transcription spends Sarvam credits.
MAX_VOICES_PER_USER=3
DAILY_SPEECH_CHARS=2000
DAILY_CONSENTS=10
DAILY_TRANSCRIBE_SECONDS=600
AUTH_ATTEMPTS_PER_HOUR=20

PORT=8080
