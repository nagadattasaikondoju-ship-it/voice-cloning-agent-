# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Storage
STORAGE_DIR=storage
SQLITE_DB_PATH=storage/pipeline.db

# Whisper ASR Configuration
# Device: auto (detect CUDA), cuda, or cpu
WHISPER_DEVICE=auto
# Model fallback: uses WHISPER_MODEL_GPU if CUDA available, else WHISPER_MODEL_CPU
WHISPER_MODEL_GPU=large-v3
WHISPER_MODEL_CPU=base
# Compute type: auto, float16, int8_float16, int8, float32
WHISPER_COMPUTE_TYPE=auto
# Language: empty for auto-detect, or language code (e.g., en, es, fr, de, hi)
WHISPER_LANGUAGE=
# Word level timestamps
WHISPER_WORD_TIMESTAMPS=true

# Silero VAD Configuration
VAD_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION_MS=200
VAD_MIN_SILENCE_DURATION_MS=400
VAD_SPEECH_PAD_MS=200
VAD_MAX_SPEECH_DURATION_S=5.0
VAD_OVERLAP_MS=200

# Pipeline Execution
PARALLEL_WORKERS=1
PARAGRAPH_SILENCE_THRESHOLD_S=1.5
