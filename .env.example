# Copy to .env (next to docker-compose.yml). Never commit .env.

# REQUIRED: generate with `openssl rand -hex 32`
JWT_SECRET=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Voice model (runs locally, free, no API keys):
#   turbo        English, fastest, fits a 4 GB GPU
#   multilingual 23 languages incl. Hindi, slower, needs more memory
CHATTERBOX_MODEL=turbo
# auto | cuda | cpu
CHATTERBOX_DEVICE=auto
# Worker image: cu124 (NVIDIA GPU; also works on CPU) or cpu (smaller image, no GPU)
TORCH_VARIANT=cu124

# Whisper (consent checks, audio -> script) runs on CPU: tiny | base | small | medium
WHISPER_MODEL_CPU=base
