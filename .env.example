# Copy to .env (next to docker-compose.yml) and fill in. Never commit .env.

# REQUIRED: generate with `openssl rand -hex 32`
JWT_SECRET=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional paid engines (leave empty to disable). Free F5-TTS works without keys.
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=
# Optional: Hugging Face token raises F5-TTS ZeroGPU quota
HF_TOKEN=

# Whisper model on CPU: tiny | base | small | medium (bigger = more accurate, slower)
WHISPER_MODEL_CPU=base
