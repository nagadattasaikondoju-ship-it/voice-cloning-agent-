# Copy to .env (next to docker-compose.yml). Never commit .env.

# REQUIRED: generate with `openssl rand -hex 32`
JWT_SECRET=

# Sites allowed to call the API. Includes the hosted dashboard on Vercel.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://voice-cloning-studio-beta.vercel.app

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Voice model: Chatterbox Turbo (English), runs locally, free, no API keys.
# Device: auto | cuda | cpu
CHATTERBOX_DEVICE=auto
# Worker image: cu124 (NVIDIA GPU; also works on CPU) or cpu (smaller image, no GPU)
TORCH_VARIANT=cu124

# Whisper (consent checks, audio -> script) runs on CPU: tiny | base | small | medium
WHISPER_MODEL_CPU=base
