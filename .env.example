# Copy to .env (next to docker-compose.yml). Never commit .env.

# REQUIRED: generate with `openssl rand -hex 32`
JWT_SECRET=

# Sites allowed to call the API. Includes the hosted dashboard on Vercel.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://voice-cloning-studio-beta.vercel.app

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# REQUIRED: Sarvam AI voice cloning API key, from https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Language of the text: empty = auto-detect, or en-IN hi-IN bn-IN ta-IN te-IN kn-IN ml-IN mr-IN gu-IN pa-IN od-IN as-IN
SARVAM_LANGUAGE=
# Clean background noise from reference clips (adds ~1 s per request)
SARVAM_REMOVE_NOISE=false

# Whisper (consent checks, audio -> script) runs on CPU: tiny | base | small | medium
WHISPER_MODEL_CPU=base
