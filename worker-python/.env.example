REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone

# Same private storage directory the Rust API writes to
STORAGE_DIR=../backend-rust/private_storage

# turbo (English, fast, fits 4 GB GPUs) | multilingual (23 languages, slower)
CHATTERBOX_MODEL=turbo
# auto | cuda | cpu
CHATTERBOX_DEVICE=auto
CHATTERBOX_SEED=42
