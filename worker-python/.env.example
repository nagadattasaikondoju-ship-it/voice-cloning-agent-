REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone

# Shared private storage (same directory the Rust API writes to)
STORAGE_TYPE=local
STORAGE_DIR=../backend-rust/private_storage

# Whisper speech pipeline (transcribes F5 reference clips)
SPEECH_PIPELINE_URL=http://localhost:8000

# --- Engines: leave a key empty to disable that engine ---
# Free: F5-TTS via Hugging Face Space (optional token raises GPU quota)
F5_SPACE=mrfakename/E2-F5-TTS
HF_TOKEN=

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

ELEVENLABS_API_KEY=

S3_ENDPOINT=
S3_BUCKET=voiceclone-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
