# Redis Queue URL
REDIS_URL=redis://localhost:6379/0

# MiniMax API Credentials (injected securely by Antigravity)
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Database URL for job state updates
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone

# Private Storage Configuration
STORAGE_TYPE=local
STORAGE_DIR=../backend-rust/private_storage
S3_ENDPOINT=
S3_BUCKET=voiceclone-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
