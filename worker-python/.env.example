REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceclone

# Same private storage directory the Rust API writes to
STORAGE_DIR=../backend-rust/private_storage

# Sarvam AI voice cloning: key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Empty = auto-detect from the text, or e.g. en-IN, hi-IN, te-IN, ta-IN
SARVAM_LANGUAGE=
SARVAM_REMOVE_NOISE=false
